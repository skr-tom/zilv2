# 复制本文件为 keystore.properties，改成自己的值。
# keystore.properties 和 release.jks 都不要提交到公开仓库！
#
# 生成密钥库（只需一次，之后每次发版都用它）：
# keytool -genkeypair -v -keystore release.jks -alias zilu -keyalg RSA -keysize 2048 -validity 10000
#
# 一旦用这把签名发过版，就再也不要换，否则用户无法覆盖安装。
storeFile=release.jks
storePassword=替换成密钥库密码
keyAlias=zilu
keyPassword=替换成密钥密码
